{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "objc",
      "camelcase": "ObjC",
      "title": "Objective-C",
      "scope": "source.objc",
      "path": ".",
      "file-types": [
        "h",
        "m",
        "objc"
      ],
      "class-name": "TreeSitterObjC",
      "highlights": [
        "node_modules/tree-sitter-c/queries/highlights.scm",
        "queries/highlights.scm"
      ],
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^(objc|objectivec)$"
    }
  ],
  "metadata": {
    "version": "3.0.2",
    "license": "MIT",
    "description": "Objective-C grammar for tree-sitter",
    "authors": [
      {
        "name": "Amaan Qureshi",
        "email": "amaanq12@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter-grammars/tree-sitter-objc"
    }
  }
}
